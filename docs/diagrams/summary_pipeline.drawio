<mxfile host="app.diagrams.net"><diagram name="summary_pipeline" id="p1"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Editing Scenario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;title, summary, scenes (chronological)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;each with a description and a reason&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="30" width="540" height="100" as="geometry"/></mxCell><mxCell id="4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Scenario Recommendation (GPT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;captions + times → JSON&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;missing scenes dropped, sorted by time&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF3D3;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="540" height="120" as="geometry"/></mxCell><mxCell id="5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="190" as="sourcePoint"/><mxPoint x="750" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Segment Captions (GPT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;what is visible in each segment,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;from its key frames&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECE8F8;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="370" width="540" height="110" as="geometry"/></mxCell><mxCell id="7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="370" as="sourcePoint"/><mxPoint x="750" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="&lt;b style=&quot;font-size:16px&quot;&gt;Key Frames&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;≈ 1 per 8 s (2–5) + importance peak&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;1024 px, detail = high&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="540" width="540" height="120" as="geometry"/></mxCell><mxCell id="9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="540" as="sourcePoint"/><mxPoint x="750" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="&lt;b style=&quot;font-size:16px&quot;&gt;MMR Selection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;0.7 · importance − 0.3 · similarity to picked&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;8 segments, returned in time order&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF3D3;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="540" height="130" as="geometry"/></mxCell><mxCell id="11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="720" as="sourcePoint"/><mxPoint x="750" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="&lt;b style=&quot;font-size:16px&quot;&gt;Segment Importance (I)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;per W-s window: mean of the top&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;half of the saliency, rank-normalised&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="170" y="920" width="440" height="120" as="geometry"/></mxCell><mxCell id="13" value="&lt;b style=&quot;font-size:16px&quot;&gt;Segment Content Vector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;per W-s window:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;mean of [ CLIP ; 0.5 · CLAP ]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="890" y="920" width="440" height="120" as="geometry"/></mxCell><mxCell id="14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="920" as="sourcePoint"/><mxPoint x="620" y="850" as="targetPoint"/><Array as="points"><mxPoint x="390" y="880"/><mxPoint x="620" y="880"/></Array></mxGeometry></mxCell><mxCell id="15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="920" as="sourcePoint"/><mxPoint x="880" y="850" as="targetPoint"/><Array as="points"><mxPoint x="1110" y="880"/><mxPoint x="880" y="880"/></Array></mxGeometry></mxCell><mxCell id="16" value="&lt;b style=&quot;font-size:16px&quot;&gt;Saliency Score (S)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;UniVTG saliency only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;(no audio)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="360" height="120" as="geometry"/></mxCell><mxCell id="17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="1110" as="sourcePoint"/><mxPoint x="260" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="&lt;b style=&quot;font-size:16px&quot;&gt;UniVTG + Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;2-s pooling → Linear Adapter 768→512 →&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;frozen UniVTG saliency (cosine with title)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="500" height="130" as="geometry"/></mxCell><mxCell id="19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="1290" as="sourcePoint"/><mxPoint x="260" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="&lt;b style=&quot;font-size:16px&quot;&gt;Video Title&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;file name&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="240" height="90" as="geometry"/></mxCell><mxCell id="21" value="&lt;b style=&quot;font-size:16px&quot;&gt;Visual Features&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;CLIP ViT-L/14, 768-d&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="520" y="1530" width="280" height="90" as="geometry"/></mxCell><mxCell id="22" value="&lt;b style=&quot;font-size:16px&quot;&gt;Audio Features&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;CLAP, 512-d&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="1060" y="1530" width="280" height="90" as="geometry"/></mxCell><mxCell id="23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="1530" as="sourcePoint"/><mxPoint x="180" y="1420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B4558;strokeColor=#3B4558;" vertex="1" parent="1"><mxGeometry x="656" y="1476" width="8" height="8" as="geometry"/></mxCell><mxCell id="25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=none;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="1480" as="sourcePoint"/><mxPoint x="440" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1480" as="sourcePoint"/><mxPoint x="440" y="1420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=none;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="1530" as="sourcePoint"/><mxPoint x="660" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="1480" as="sourcePoint"/><mxPoint x="1050" y="1040" as="targetPoint"/><Array as="points"><mxPoint x="1050" y="1480"/></Array></mxGeometry></mxCell><mxCell id="29" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="1530" as="sourcePoint"/><mxPoint x="1200" y="1040" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net"><diagram name="highlight_pipeline" id="p1"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Highlight Clips&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;greedy peak picking, 3 s up to window W,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;gap ≥ 2 s, total ≈ 10 % (15–60 s)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="550" y="30" width="400" height="100" as="geometry"/></mxCell><mxCell id="4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Highlight Score&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;per second, 0–1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="575" y="190" width="350" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Weighted Late Fusion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;0.7 S + 0.3 A&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B566A&quot;&gt;each term rank-normalised, smoothed 3 s&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF3D3;strokeColor=#3B4558;strokeWidth=2;fontColor=#2F3A4C;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="540" height="120" as="geometry"/></mxCell><mxCell id="6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3B4558;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="190" as="sourcePoint"/><mxPoint